{
  "name": "email-scheduler-backend",
  "private": true,
  "version": "1.0.0",
  "description": "ReachInbox assignment backend: Express + BullMQ + Redis + MySQL + Ethereal",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:worker": "tsx src/worker-entry.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker-entry.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "ioredis": "^5.4.1",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/sanitize-html": "^2.11.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^5.0.1"
  }
}
